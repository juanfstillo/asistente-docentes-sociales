# Copiar a .env y completar.

# Modelo que responde: "ollama" (local, gratis), "groq" (nube, capa gratuita)
# o "gemini" (API de Google).
LLM_PROVIDER=ollama

# --- Groq (clave gratis en https://console.groq.com/keys) ---
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b   # también en la capa gratuita: openai/gpt-oss-20b, qwen/qwen3.8-27b
# Con Groq conviene CONTEXT_CHARS=7000 (más abajo): la capa gratuita permite
# 8.000 tokens por minuto y 200.000 por día.

# --- Ollama (https://ollama.com) ---
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=gemma3:4b       # tiene que estar descargado: ollama pull <modelo>
# OLLAMA_NUM_CTX=8192          # ventana de contexto en tokens

# --- Gemini (clave en https://aistudio.google.com/apikey) ---
# GEMINI_API_KEY=
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash
# GEMINI_THINKING_LEVEL=low    # minimal | low | medium | high

# Token del bot de Telegram (lo da @BotFather). Vacío = Telegram desactivado.
TELEGRAM_BOT_TOKEN=

# Opcionales
# PORT=3000
# TRUST_PROXY=1                # si corre detrás de nginx/Caddy
# CONTEXT_CHARS=12000          # texto de instructivos por consulta; "all" = todos completos
# MAX_HISTORY=8                # mensajes de la conversación que se recuerdan
